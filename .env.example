# 이 파일을 복사해서 .env 만들고 값 채우기: cp .env.example .env
# .env는 .gitignore에 걸려있어서 커밋 안 됨 — 각자 로컬에만 존재

# --- docker-compose.yml (MySQL 컨테이너) ---
MYSQL_DATABASE=travelbird
MYSQL_USER=travelbird
MYSQL_PASSWORD=travelbird_local_pw
MYSQL_ROOT_PASSWORD=root_local_pw
MYSQL_PORT=3306

# --- application.properties (Spring Boot이 읽는 값) ---
# 위 MYSQL_PORT/DATABASE와 일치해야 함
DB_URL=jdbc:mysql://localhost:3306/travelbird?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=travelbird
DB_PASSWORD=travelbird_local_pw

JWT_SECRET=dev-only-local-secret-key-please-override-in-real-envs-32bytes+

# 한국관광공사 TourAPI 개인 발급 서비스키 (축제·이벤트 배치용, 없으면 빈 값으로 둬도 앱은 뜸)
TOUR_API_SERVICE_KEY=
